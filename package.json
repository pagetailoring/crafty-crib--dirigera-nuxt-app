{
  "name": "nuxt-template-with-ui-and-storybook",
  "version": "0.0.1",
  "author": "pagetailoring",
  "type": "module",
  "private": true,
  "scripts": {
    "analyze": "nuxt analyze",
    "build": "nuxt build",
    "clean": "nuxt cleanup && rm -rf dist node_modules .firebase .output .nuxt",
    "dev": "run-s host:start",
    "dev:start": "nuxt dev",
    "host:start": "nuxt dev --host",
    "generate": "nuxt generate",
    "lint": "run-p eslint prettier typecheck tsc",
    "lint:fix": "run-s prettier:fix eslint:fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "eslint": "eslint . --cache",
    "eslint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "tsc": "vue-tsc --noEmit",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "start": "node .output/server/index.mjs",
    "up": "nuxt upgrade"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "@pinia/nuxt": "1.0.2",
    "dirigera": "2.0.2",
    "graphql": "^16.14.2",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/html-validator": "2.1.0",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.6",
    "npm-run-all2": "^9.0.3",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
