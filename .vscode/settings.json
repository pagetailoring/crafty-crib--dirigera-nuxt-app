{
  "js/ts.experimental.useTsgo": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,

  "files.trimTrailingWhitespace": true,
  "editor.wordWrap": "on",
  "files.insertFinalNewline": true,

  // Quiet mode - adhd dx - for adhd dx
  "files.exclude": {
    // Main directories to exclude/include
    ".nuxt": true,
    ".output": true,
    "dist": true,
    "**/node_modules": true,
    ".eslintcache": true
  },
  "material-icon-theme.activeIconPack": "vue",
  "material-icon-theme.folders.associations": {
    "crud": "update",
    "codex": "robot",
    "table": "database",
    "firebase": "firebase",
    "pomodoro": "temp",
    "chart": "scons",
    "new-logs": "input",
    "edit": "ci",
    "composables": "src",
    "stores": "store",
    "table/cell": "log",
    "copy-value": "functions",
    "form-manual": "input",
    "calendar": "coverage",
    "summary": "graphql",
    "work": "changesets",
    "header": "ui"
  }
}
